# Copy to .env and fill in. Never commit .env.
#
# Same three names the Streamlit deployment uses for its secrets, so the app and the
# CLI share one convention.
GPT_OSS_API_KEY=
GEMMA_API_KEY=
LLAMA_API_KEY=

# Optional shared fallback, used for any model without its own key above.
NVIDIA_API_KEY=

# Which model grades the runs. There is no separate judge key: the judge's credential
# is looked up from whichever model you name here, using the keys above.
#
# It must NOT be one of the three models under test, otherwise a model grades its own
# rulings and its own confessions. run_eval.py exits rather than run that configuration.
JUDGE_MODEL=

# Base URL for the OpenAI-compatible endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
