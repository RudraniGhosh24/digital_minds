# Copy to .env and fill in. Never commit .env.
#
# Three separate NVIDIA NIM keys, one per model. These are the same names the
# Streamlit deployment uses for its secrets.
GPT_OSS_API_KEY=nvapi-...
GEMMA_API_KEY=nvapi-...
LLAMA_API_KEY=nvapi-...

# Optional. Only used for a model that has no per-model key above.
NVIDIA_API_KEY=

# External judge. Defaults to openai/gpt-oss-20b, matching the paper.
#
# gpt-oss-20b is also one of the three subjects, so for its own rows it grades its
# own rulings and its own confessions. This is not blocked: the model set is fixed
# by the paper. The overlap is per-cell, so only the 5 gpt-oss-20b rows are
# affected; those rows are tagged `self_judged` and analyze.py reports them
# separately from the 10 unconflicted rows.
JUDGE_MODEL=openai/gpt-oss-20b

# Base URL for the OpenAI-compatible endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
