# Copy to .env and fill in. Never commit .env.
#
# One key per subject model. If your account uses a single key for all NIM
# endpoints, set NVIDIA_API_KEY only and leave the per-model keys blank.
NVIDIA_API_KEY=

# Optional per-model overrides.
NVIDIA_API_KEY_GPT_OSS=
NVIDIA_API_KEY_DIFFUSIONGEMMA=
NVIDIA_API_KEY_MUSE_GLIMMER=

# The judge MUST NOT be one of the three subject models, otherwise a model
# grades its own rulings and confessions. run_eval.py prints a loud warning
# if you violate this. Pick any capable model you have access to.
JUDGE_MODEL=
JUDGE_API_KEY=

# Base URL for the OpenAI-compatible endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
